import pygame
pygame.init()
screen = pygame.display.set_mode([500,500])
pygame.display.set_caption("Flappybird!")

red = (255,0,0)
blue = (0,0,255)
green = (0,255,0)
yellow = (255,255,0)
white = (255,255,255)
black = (0,0,0)

class bird:
    def __init__(self):#not putting atributes because we are giving the actual values, like parameters in a function
        self.x = 80
        self.y = 250
        self.radius = 20
        self.velocity = 0
        self.gravity = 0.5
        self.jumpstrength = -8 # initisalising atributes, all of the above
        
        def jump (self):
            self.velocity = self.jumpstrength
            
        def move(self):
            self.velocity += self.gravity #incrementing gravity to allow bird to fall down
            self.y += self.velocity #showing that the velocity is bringing the ball down

        def draw(self,screen):
            pygame.draw.circle(screen,yellow,(self.x,int(self.y)),self.radius)# we are not putting x as an integer because x is already an integer
            #initially both x and y are integers however y is affected by the velocity which inturn is affected by gravity
            #gravity is decreasing by 0.5 which which affects y by turning it into a float number instead of an integer
            #we must replace y as an interger since it is a co-ordinate and co-ordinates cannot be floats


#pipes
class pipes:
    def init__(self,colour,x,y,length,width):
        self.colour = colour
        self.x = x
        self.y = y
        self.length = length
        self.width = width 
        

    def draw(self,surface):
        pygame.draw.rect(surface,self.colour,(self.x,self.y,self.length,self.width))

pipe1 = pipes(green,0,350,100,35)
pipe2 = pipes(green,500,350,70,35)

while True:
    screen.fill((26,189,230))
    for event in pygame.event():
        if event.type == pygame.QUIT:
            pygame.quit()
    pipe1.draw(screen)
    pipe2.draw(screen)
    pygame.display.update()